---
import GeneratorTextInput from "../components/GeneratorTextInput.astro";
import Layout from "../layouts/Layout.astro";
import GeneratorColumn from "../components/GeneratorColumn.astro";
import GeneratorWrapper from "../components/GeneratorWrapper.astro";
import GeneratorDropZone from "../components/GeneratorDropZone.astro";
import GeneratorTextArea from "../components/GeneratorTextArea.astro";
import GeneratorSelectMenu from "../components/GeneratorSelectMenu.astro";
import GeneratorSection from "../components/GeneratorSection.astro";
import { ArrowTopRightOnSquareIcon, CubeIcon, LinkIcon, PhotoIcon, PuzzlePieceIcon, UserIcon } from "@heroicons/react/20/solid";
import { ModLoader } from "../../../shared/types/ModLoader";
import { compareAlphabeticallyAscInsensitive } from "../../../shared/comparisonFunctions";

export interface GeneratorScriptData {
  /** The GitHub org/repo name. */
  repo: string;

  /** The repo branch name */
  branch: string;
}
---

<Layout
  title="Mod JSON Generator"
  linkHome={true}
  pageScriptData={{
    repo: (import.meta as any).env.GITHUB_REPOSITORY || "",
    branch: (import.meta as any).env.REPO_BRANCH || ""
  }}
>
  <GeneratorWrapper>
    <GeneratorColumn fullWidth>
      <p class="text-center text-sm text-white/85 text-shadow-[0_1px_4px_rgba(0,0,0,0.9)]">
        Fill in your mod's details, then open a pre-filled file on GitHub to add it to the mod list.
      </p>
      <GeneratorDropZone id="loadQmod">
        Drop a .qmod here, or click to browse
        <Fragment slot="status">Fills in the details from its mod.json, plus anything missing from the mod's latest listed version.</Fragment>
      </GeneratorDropZone>
    </GeneratorColumn>
    <GeneratorColumn>
      <GeneratorSection
        title="Mod details"
        description="What players see on the mod card."
      >
        <CubeIcon
          slot="icon"
          className="size-5"
          aria-hidden="true"
        />
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <GeneratorTextInput
            id="modName"
            placeholder="The name of the mod"
            required
          >
            Mod Name
          </GeneratorTextInput>
          <GeneratorTextInput
            id="modId"
            placeholder="The ID of the mod"
            required
          >
            Mod ID
            <Fragment slot="hint">A listed mod's ID fills empty fields from its latest version.</Fragment>
          </GeneratorTextInput>
        </div>
        <GeneratorTextArea
          id="modDescription"
          placeholder="A description of what the mod does"
          rows={3}
        >
          Mod Description
        </GeneratorTextArea>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <GeneratorTextInput
            id="modCreators"
            placeholder="Who made this mod?"
          >
            Mod Creator(s)
            <Fragment slot="hint">Separate multiple names with commas.</Fragment>
          </GeneratorTextInput>
          <GeneratorSelectMenu
            id="modAi"
            values={[
              ["", "Select AI usage", true],
              ["none", "No AI used", false],
              ["assisted", "AI Assisted", false],
              ["fully-vibed", "Vibe Coded", false]
            ]}
            required
          >
            AI Usage
            <p
              slot="description"
              id="modAiDescription"
              class="generator-hint"
              aria-live="polite"
            >
              Select an option to see what it means.
            </p>
          </GeneratorSelectMenu>
        </div>
      </GeneratorSection>
      <GeneratorSection
        title="Compatibility"
        description="The game version and mod loader this build is for."
      >
        <PuzzlePieceIcon
          slot="icon"
          className="size-5"
          aria-hidden="true"
        />
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <GeneratorTextInput
            id="modVersion"
            placeholder="e.g. 1.0.0"
            required
          >
            Mod Version
          </GeneratorTextInput>
          <GeneratorTextInput
            id="targetGameVersion"
            placeholder="e.g. 1.40.8_7379"
            required
          >
            Game Version
          </GeneratorTextInput>
          <GeneratorSelectMenu
            id="modLoader"
            values={Object.keys(ModLoader)
              .sort(compareAlphabeticallyAscInsensitive)
              .map((k) => [k, k, k == ModLoader.Scotland2])}
            required
          >
            Mod Loader
          </GeneratorSelectMenu>
        </div>
      </GeneratorSection>
    </GeneratorColumn>
    <GeneratorColumn>
      <GeneratorSection
        title="Links"
        description="Paste or drag links in. A GitHub release link fills in the rest."
      >
        <LinkIcon
          slot="icon"
          className="size-5"
          aria-hidden="true"
        />
        <GeneratorTextInput
          id="modDownloadLink"
          placeholder="https://github.com/user/repo/releases/download/v1.0.0/Mod.qmod"
          type="url"
          required
        >
          Download Link
          <Fragment slot="hint">A direct link to the .qmod file.</Fragment>
        </GeneratorTextInput>
        <GeneratorTextInput
          id="modSourceLink"
          placeholder="A link to the source code for the mod"
          type="url"
        >
          Source Code
        </GeneratorTextInput>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <GeneratorTextInput
            id="modWebsiteLink"
            placeholder="A website for the mod"
            type="url"
          >
            Website
          </GeneratorTextInput>
          <GeneratorTextInput
            id="modFundingLink"
            placeholder="Donation page URL"
            type="url"
          >
            Funding
          </GeneratorTextInput>
        </div>
      </GeneratorSection>
      <GeneratorSection
        title="Images"
        description="Shown on the mod card. The previews update as you type."
      >
        <PhotoIcon
          slot="icon"
          className="size-5"
          aria-hidden="true"
        />
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <GeneratorTextInput
            id="authorIcon"
            placeholder="URL to a square image"
            type="url"
          >
            Author Icon URL
          </GeneratorTextInput>
          <GeneratorTextInput
            id="modCover"
            placeholder="URL to a cover image"
            type="url"
          >
            Cover Link
          </GeneratorTextInput>
        </div>
        <div class="grid grid-cols-2 items-center gap-3">
          <div class="flex size-16 items-center justify-center overflow-hidden rounded-full bg-black/25 ring-1 ring-card-border">
            <img
              id="authorIconPreview"
              alt="Author icon preview"
              class="hidden size-full object-cover"
            />
            <span id="authorIconPlaceholder">
              <UserIcon
                className="size-7 text-card-body-text/40"
                aria-hidden="true"
              />
            </span>
          </div>
          <div class="flex aspect-[178/100] w-full min-w-0 items-center justify-center overflow-hidden rounded-lg bg-card-header-bg ring-1 ring-card-border">
            <img
              id="modCoverPreview"
              alt="Cover image preview"
              class="hidden size-full object-contain"
            />
            <span
              id="modCoverPlaceholder"
              class="text-xs text-card-body-text/50"
            >
              No cover image
            </span>
          </div>
        </div>
      </GeneratorSection>
    </GeneratorColumn>
    <GeneratorColumn
      fullWidth
      class="sticky bottom-3 z-10"
    >
      <div class="flex flex-col gap-3 rounded-xl border border-card-border bg-card-body-bg p-3 text-card-body-text shadow-2xl backdrop-blur-md sm:flex-row sm:items-center sm:justify-between sm:pl-5">
        <p class="hidden text-sm leading-snug text-card-body-text/70 sm:block">
          <span class="text-error">*</span> Required. The button opens GitHub with the JSON file filled in, ready to propose as a pull request.
        </p>
        <button
          class="btn btn-primary w-full shrink-0 gap-2 rounded-lg text-white sm:w-auto"
          id="generateJson"
          type="button"
        >
          Create JSON on GitHub
          <ArrowTopRightOnSquareIcon
            className="size-4"
            aria-hidden="true"
          />
        </button>
      </div>
    </GeneratorColumn>
  </GeneratorWrapper>
</Layout>
<script>
  import JSZip from "jszip";
  import { sanitizeFilename } from "../../../shared/sanitizeFilename";
  import { splitModKeys, type Mod } from "../../../shared/types/Mod";
  import type { ModsCollection } from "../../../shared/types/ModsCollection";
  import type { QmodInfo } from "../../../shared/types/QmodInfo";
  import { fetchJson } from "../../../shared/fetch";
  import { ghRegex } from "../../../shared/ghRegex";
  import { getStandardizedMod } from "../../../shared/getStandardizedMod";
  import { getGithubIconUrl } from "../../../shared/getGithubIconUrl";
  import { getQmodCoverUrl } from "../../../shared/getQmodCoverUrl";
  import { isNullOrWhitespace } from "../../../shared/isNullOrWhitespace";
  import { validateMod } from "../../../shared/validateMod";
  import { ModLoader } from "../../../shared/types/ModLoader";
  import { aiUsageValues, type AiUsage } from "../../../shared/types/AiUsage";
  import { getPageScriptData } from "../../../shared/getPageScriptData";
  import { compareVersionDescending } from "../../../shared/comparisonFunctions";
  import type { GeneratorScriptData } from "./generator.astro";

  (async () => {
    function getElementById(id) {
      return document.getElementById(id);
    }

    const { repo, branch } = getPageScriptData<GeneratorScriptData>();
    const modNameElement = getElementById("modName") as HTMLInputElement,
      modDescriptionElement = getElementById("modDescription") as HTMLTextAreaElement,
      modIdElement = getElementById("modId") as HTMLInputElement,
      loadQmodElement = getElementById("loadQmod") as HTMLInputElement,
      modDownloadLinkElement = getElementById("modDownloadLink") as HTMLInputElement,
      modSourceLinkElement = getElementById("modSourceLink") as HTMLInputElement,
      modWebsiteLinkElement = getElementById("modWebsiteLink") as HTMLInputElement,
      modFundingLinkElement = getElementById("modFundingLink") as HTMLInputElement,
      modCoverElement = getElementById("modCover") as HTMLInputElement,
      modCreatorsElement = getElementById("modCreators") as HTMLInputElement,
      authorIconElement = getElementById("authorIcon") as HTMLInputElement,
      modVersionElement = getElementById("modVersion") as HTMLInputElement,
      targetGameVersionElement = getElementById("targetGameVersion") as HTMLInputElement,
      modLoaderElement = getElementById("modLoader") as HTMLSelectElement,
      modAiElement = getElementById("modAi") as HTMLSelectElement,
      modAiDescriptionElement = getElementById("modAiDescription") as HTMLParagraphElement,
      qmodDropZoneElement = document.body,
      loadQmodStatusElement = getElementById("loadQmodStatus") as HTMLElement,
      authorIconPreviewElement = getElementById("authorIconPreview") as HTMLImageElement,
      authorIconPlaceholderElement = getElementById("authorIconPlaceholder") as HTMLElement,
      modCoverPreviewElement = getElementById("modCoverPreview") as HTMLImageElement,
      modCoverPlaceholderElement = getElementById("modCoverPlaceholder") as HTMLElement,
      modIdHintElement = getElementById("modIdHint") as HTMLParagraphElement,
      generateButtonElement = getElementById("generateJson");

    if (
      !modNameElement ||
      !modDescriptionElement ||
      !modIdElement ||
      !loadQmodElement ||
      !modDownloadLinkElement ||
      !modSourceLinkElement ||
      !modWebsiteLinkElement ||
      !modFundingLinkElement ||
      !modCoverElement ||
      !modCreatorsElement ||
      !authorIconElement ||
      !modVersionElement ||
      !targetGameVersionElement ||
      !modLoaderElement ||
      !modAiElement ||
      !modAiDescriptionElement ||
      !qmodDropZoneElement ||
      !loadQmodStatusElement ||
      !authorIconPreviewElement ||
      !authorIconPlaceholderElement ||
      !modCoverPreviewElement ||
      !modCoverPlaceholderElement ||
      !modIdHintElement ||
      !generateButtonElement
    ) {
      throw new Error();
    }

    const aiDescriptions: Record<AiUsage, string> = {
      none: "No AI was used to create this mod.",
      assisted: "AI helped write the code, and you understand what it does and how it works.",
      "fully-vibed": "AI wrote the code, and you don't understand what it does or how it works."
    };

    function updateAiDescription() {
      modAiDescriptionElement.textContent = aiDescriptions[modAiElement.value as AiUsage]
        || "Select an option to see what it means.";
    }

    modAiElement.addEventListener("change", () => {
      delete modAiElement.dataset.needsInput;
      updateAiDescription();
    });
    updateAiDescription();

    let modJson: ModsCollection = {};

    // Load the mod.json file
    const modJsonLoaded = (async function loadModJson() {
      try {
        const result = await fetchJson<ModsCollection>(`mods.json?${Math.floor(Date.now() / 1000)}`);

        if (result.data) {
          modJson = result.data;
        }
      } catch (error) {}
    })();

    /** Where previously submitted mod files are read from. Pages built outside CI have no repo set, so use the main list. */
    const lookupRepo = repo || "QuestPackageManager/bsqmods";
    const lookupBranch = branch || "main";

    interface KnownMod {
      mod: Mod;
      gameVersion: string;
    }

    type FillableElement = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

    /** Values filled in from a previous version, so they can be taken back out if the mod changes. */
    const prefilledValues = new Map<FillableElement, string>();
    let knownModLookup = 0;
    const defaultModIdHint = modIdHintElement.textContent || "";

    modIdHintElement.setAttribute("aria-live", "polite");

    /**
     * Sets a field's value as if the user typed it, so it is no longer treated as filled from a previous version.
     */
    function setFieldValue(element: FillableElement, value: string) {
      element.value = value;
      prefilledValues.delete(element);
      delete element.dataset.prefilled;
    }

    /**
     * Empties the fields that still hold a value filled from a previous version.
     */
    function clearPrefilledValues() {
      for (const [element, value] of prefilledValues) {
        if (element.value == value) {
          element.value = "";
        }

        delete element.dataset.prefilled;
      }

      prefilledValues.clear();
      updateAiDescription();
    }

    /**
     * Finds every listed version of a mod, newest first, preferring the newest game version when a mod version is listed for several.
     * @param id The mod ID, matched case-insensitively.
     */
    function findKnownMods(id: string): KnownMod[] {
      const wantedId = id.trim().toLowerCase();

      if (!wantedId) {
        return [];
      }

      const matches: KnownMod[] = [];

      for (const [gameVersion, mods] of Object.entries(modJson)) {
        for (const mod of mods) {
          if (mod.id?.toLowerCase() == wantedId) {
            matches.push({ mod, gameVersion });
          }
        }
      }

      matches.sort(
        (a, b) => compareVersionDescending(a.mod.version, b.mod.version) || compareVersionDescending(a.gameVersion, b.gameVersion)
      );

      return matches;
    }

    /**
     * Finds the newest listed version of a mod.
     * @param id The mod ID, matched case-insensitively.
     */
    function findLatestKnownMod(id: string): KnownMod | null {
      return findKnownMods(id)[0] ?? null;
    }

    /**
     * Finds the AI usage of the newest listed version of a mod that has one. Versions listed before the AI field
     * existed have none, so older versions are checked too.
     * @param id The mod ID, matched case-insensitively.
     */
    function findKnownAiUsage(id: string): { ai: AiUsage; known: KnownMod } | null {
      for (const known of findKnownMods(id)) {
        if (aiUsageValues.includes(known.mod.ai as AiUsage)) {
          return { ai: known.mod.ai as AiUsage, known };
        }
      }

      return null;
    }

    /**
     * Gets the mod as it was submitted. The combined mods.json points covers and downloads at the mirror, while the
     * repo's own file keeps the original links.
     */
    async function getSubmittedMod(known: KnownMod): Promise<Mod> {
      try {
        const path = getFilename(known.mod.id || "", known.mod.version || "", known.gameVersion);
        const result = await fetchJson<Mod>(`https://raw.githubusercontent.com/${lookupRepo}/${lookupBranch}/${encodeURI(path)}`);

        if (result.data?.id?.toLowerCase() == known.mod.id?.toLowerCase()) {
          return result.data!;
        }
      } catch (error) {
        console.warn("Couldn't load the submitted mod file, using mods.json instead:", error);
      }

      return { ...known.mod, cover: known.mod.ogCover || known.mod.cover };
    }

    /**
     * Fills empty fields from the latest listed version of the mod in the Mod ID field.
     * @returns A short summary for the drop zone, or null when nothing was found.
     */
    async function fillFromKnownMod(): Promise<string | null> {
      const lookup = ++knownModLookup;

      clearPrefilledValues();
      updateImagePreviews();

      if (isNullOrWhitespace(modIdElement.value)) {
        modIdHintElement.textContent = defaultModIdHint;
        return null;
      }

      modIdHintElement.textContent = "Looking for earlier versions…";
      await modJsonLoaded;

      const known = findLatestKnownMod(modIdElement.value);
      const previous = known && (await getSubmittedMod(known));

      if (lookup != knownModLookup) {
        return null;
      }

      if (!known || !previous) {
        modIdHintElement.textContent = "No listed versions of this mod yet.";
        return null;
      }

      let filledCount = 0;

      function fill(element: FillableElement, value: string | null | undefined) {
        value = value?.trim();

        if (!value || !isNullOrWhitespace(element.value)) {
          return;
        }

        if (element instanceof HTMLSelectElement && ![...element.options].some((option) => option.value == value)) {
          return;
        }

        element.value = value;
        element.dataset.prefilled = "";
        prefilledValues.set(element, element.value);
        filledCount++;
      }

      fill(modDescriptionElement, previous.description);
      fill(modCreatorsElement, previous.author);
      fill(modAiElement, previous.ai);

      // The latest version may predate the AI field, so fall back to the newest version that has it.
      const knownAi = isNullOrWhitespace(modAiElement.value) ? findKnownAiUsage(modIdElement.value) : null;

      if (knownAi) {
        fill(modAiElement, knownAi.ai);
      }
      fill(modSourceLinkElement, previous.source);
      fill(modWebsiteLinkElement, previous.website);
      fill(modFundingLinkElement, previous.funding?.[0]);
      fill(authorIconElement, previous.authorIcon);
      fill(modCoverElement, previous.cover);
      updateAiDescription();
      updateImagePreviews();

      const from = `v${known.mod.version} (${known.gameVersion})`;

      modIdHintElement.textContent =
        filledCount > 0
          ? `Filled ${filledCount} empty ${filledCount == 1 ? "field" : "fields"} from ${from}, outlined in blue.`
          : `Latest listed version is ${from}.`;

      return filledCount > 0 ? `filled ${filledCount} empty ${filledCount == 1 ? "field" : "fields"} from ${from}` : null;
    }

    /**
     * Gets the intended filename for the given mod values.
     * @param id The mod ID.
     * @param version The mod version.
     * @param gameVersion The game version.
     * @returns
     */
    function getFilename(id: string, version: string, gameVersion: string) {
      return `mods/${sanitizeFilename(gameVersion.trim())}/${sanitizeFilename(`${id.trim()}-${version.trim()}.json`)}`;
    }

    /**
     * Checks if a mod with the given id and version already exists for the specified game version.
     *
     * @param id The ID of the mod.
     * @param version The version of the mod.
     * @param gameVersion The version of the game.
     * @returns Returns true if the mod with the given id and version exists for the specified game version, false otherwise.
     */
    function checkMod(id: string, version: string, gameVersion: string): boolean {
      /**
       * Array of mods for the specified game version.
       * @type {Mod[]|null}
       */
      const versionMods = modJson[gameVersion];

      if (versionMods == null) {
        return false;
      }

      // Loop through all mods for the specified game version
      for (const mod of versionMods) {
        // Check if mod id and version match the given id and version
        if (mod.id == id && mod.version == version) {
          return true;
        }
      }

      return false;
    }

    /**
     * Shows the result of loading a .qmod in the drop zone.
     * @param state The drop zone state, used for its colors.
     * @param message The status text.
     */
    function setQmodStatus(state: "loaded" | "error", message: string) {
      loadQmodElement.dataset.state = state;
      loadQmodStatusElement.textContent = message;
    }

    function readQmodFile(file: File) {
      const reader = new FileReader();

      reader.onloadend = function (ev) {
        qmodLoadHandler.call(this, ev, file.name);
      };
      reader.readAsArrayBuffer(file);
    }

    /**
     * Shows a preview of an image URL, or the placeholder when the URL is empty or fails to load.
     */
    function bindImagePreview(input: HTMLInputElement, image: HTMLImageElement, placeholder: HTMLElement) {
      function showPlaceholder() {
        image.classList.add("hidden");
        placeholder.classList.remove("hidden");
      }

      image.addEventListener("load", () => {
        image.classList.remove("hidden");
        placeholder.classList.add("hidden");
      });
      image.addEventListener("error", showPlaceholder);

      return function update() {
        const url = input.value.trim();

        if (/^https?:\/\//i.test(url)) {
          if (image.getAttribute("src") !== url) {
            image.src = url;
          }
        } else {
          image.removeAttribute("src");
          showPlaceholder();
        }
      };
    }

    const imagePreviewUpdaters = [
      bindImagePreview(authorIconElement, authorIconPreviewElement, authorIconPlaceholderElement),
      bindImagePreview(modCoverElement, modCoverPreviewElement, modCoverPlaceholderElement)
    ];

    function updateImagePreviews() {
      for (const update of imagePreviewUpdaters) {
        update();
      }
    }

    for (const element of [authorIconElement, modCoverElement]) {
      element.addEventListener("input", updateImagePreviews);
      element.addEventListener("change", updateImagePreviews);
    }

    /**
     * Creates a temporary file input element and clicks it to select a .qmod file and load its information.
     * @param e
     */
    function loadQmod(e: MouseEvent) {
      /**
       * @type {HTMLInputElement}
       */
      const input = document.createElement("input") as HTMLInputElement;

      input.setAttribute("type", "file");
      input.addEventListener("change", function (e) {
        if (!this.files) {
          return;
        }

        if (!this.files[0]) {
          return;
        }

        readQmodFile(this.files[0]);
      });
      input.click();
    }

    /**
     * Generates JSON for the mod, and opens a GitHub page with a new file pre-populated with it, or the existing file if it already exists.
     */
    function generateJson(this: HTMLElement, e: Event) {
      try {
        if (!modJson[targetGameVersionElement.value]) {
          modJson[targetGameVersionElement.value] = [];
        }

        if (!aiUsageValues.includes(modAiElement.value as AiUsage)) {
          modAiElement.focus();
          alert("Please select if AI was used to create this mod.");
          return;
        }

        const funding = modFundingLinkElement.value.trim();

        let mod: Mod = getStandardizedMod(
          {
            name: modNameElement.value.trim(),
            description: modDescriptionElement.value.trim(),
            id: modIdElement.value.trim(),
            version: modVersionElement.value.trim(),
            author: modCreatorsElement.value.trim(),
            ai: modAiElement.value as AiUsage,
            authorIcon: authorIconElement.value.trim(),
            modloader: Object.keys(ModLoader).includes(modLoaderElement.value.trim())
              ? (modLoaderElement.value.trim() as ModLoader)
              : ModLoader.QuestLoader,
            download: modDownloadLinkElement.value.trim(),
            source: modSourceLinkElement.value.trim(),
            cover: modCoverElement.value.trim(),
            funding: isNullOrWhitespace(funding) ? [] : [funding],
            website: modWebsiteLinkElement.value.trim()
          },
          splitModKeys
        );

        validateMod(mod);

        const modFilename = getFilename(mod.id || "", mod.version || "", targetGameVersionElement.value);

        if (checkMod(mod.id || "", mod.version || "", targetGameVersionElement.value)) {
          alert("This mod version already exists in the json");
          window.open(`https://github.com/${repo}/edit/${branch}/${modFilename}`);
        } else {
          window.open(
            `https://github.com/${repo}/new/${branch}?filename=${encodeURIComponent(modFilename)}&value=${encodeURIComponent(`${JSON.stringify(mod, null, "  ")}\n`)}`
          );
        }
      } catch (err) {
        console.error(err);
        alert(`${err.message || err}`);
      }
    }

    /**
     * Function to handle dropping of URLs on a text input.
     * @param e - The event object.
     */
    function urlDropHandler(this: HTMLInputElement, e: DragEvent): void {
      e.preventDefault();
      e.stopPropagation();

      if (!e.dataTransfer || !e.currentTarget) {
        return;
      }

      /**
       * @type {HTMLInputElement}
       */
      const input = e.currentTarget as HTMLInputElement;
      const url = e.dataTransfer.getData("URL");

      input.value = url;
      input.dispatchEvent(new Event("change"));
    }

    /**
     * Function to handle loading of QMOD files.
     * @param ev - The event object.
     */
    async function qmodLoadHandler(this: FileReader, ev: ProgressEvent<FileReader>, fileName: string) {
      const reader = this;

      if (reader.result) {
        try {
          const zip = await JSZip.loadAsync(reader.result);
          const modFile = zip.file("mod.json");

          if (!modFile) {
            console.error("No mod.json");
            setQmodStatus("error", `${fileName} has no mod.json. Is it a .qmod file?`);
            return;
          }

          const modInfo: QmodInfo = JSON.parse(await modFile.async("string"));

          // Take out values filled from the previous mod's listing before this mod's own values go in.
          clearPrefilledValues();
          modNameElement.value = modInfo.name || "";
          modDescriptionElement.value = modInfo.description || "";
          modIdElement.value = modInfo.id || "";
          modVersionElement.value = modInfo.version || "";
          modCreatorsElement.value = (!modInfo.porter ? "" : modInfo.porter + ",") + modInfo.author;
          targetGameVersionElement.value = modInfo.packageVersion || "";
          modLoaderElement.value = modInfo.modloader ?? "QuestLoader";
          modAiElement.value = aiUsageValues.includes(modInfo.ai as AiUsage) ? modInfo.ai! : "";
          updateAiDescription();
          modFundingLinkElement.value = "";
          modWebsiteLinkElement.value = "";
          setQmodStatus("loaded", `Loaded ${fileName}. Looking for earlier versions…`);

          const filledSummary = await fillFromKnownMod();
          const needsAi = !aiUsageValues.includes(modAiElement.value as AiUsage);

          setQmodStatus(
            "loaded",
            (filledSummary
              ? `Loaded ${fileName} and ${filledSummary}. Check the details, then add the download link.`
              : `Loaded ${fileName}. Check the details below, then add the links.`) +
              (needsAi ? " No earlier version lists AI usage, so please select it." : "")
          );

          // AI usage is required and can't be read from most .qmod files, so flag it when it's still missing.
          if (needsAi) {
            modAiElement.dataset.needsInput = "";
          } else {
            delete modAiElement.dataset.needsInput;
          }
        } catch (error) {
          console.error("Error loading QMOD file:", error);
          setQmodStatus("error", `Couldn't read ${fileName}. Is it a .qmod file?`);
        }
      } else {
        setQmodStatus("error", `Couldn't read ${fileName}.`);
      }
    }

    /**
     * Function to handle drag/drop of qmod files on the drop zone.
     * @param e
     */
    function qmodDropHandler(this: HTMLElement, e: DragEvent) {
      e.preventDefault();
      e.stopPropagation();

      if (!e.dataTransfer) {
        return;
      }

      const files = e.dataTransfer.items
        ? [...e.dataTransfer.items].filter((item) => item.kind === "file").map((item) => item.getAsFile())
        : [...e.dataTransfer.files];

      for (const file of files) {
        if (file) {
          readQmodFile(file);
        }
      }
    }

    // Highlight the drop zone while a file is dragged anywhere over the page.
    let dragDepth = 0;

    function setDragging(dragging: boolean) {
      if (dragging) {
        loadQmodElement.dataset.dragging = "";
      } else {
        dragDepth = 0;
        delete loadQmodElement.dataset.dragging;
      }
    }

    document.addEventListener("dragenter", (e) => {
      if (e.dataTransfer?.types.includes("Files")) {
        dragDepth++;
        setDragging(true);
      }
    });
    document.addEventListener("dragleave", () => {
      if (dragDepth > 0 && --dragDepth == 0) {
        setDragging(false);
      }
    });
    window.addEventListener("drop", () => setDragging(false), true);
    window.addEventListener("dragend", () => setDragging(false), true);

    /**
     * Fills in the source code text input if the link is from GitHub.
     * @param e
     */
    async function modDownloadLinkChangeHandler(this: HTMLInputElement, e: Event) {
      const match = ghRegex.exec(modDownloadLinkElement.value.trim());

      if (match) {
        setFieldValue(modSourceLinkElement, `https://github.com/${match[1]}/${match[2]}/`);
        setFieldValue(modWebsiteLinkElement, `https://github.com/${match[1]}/${match[2]}/`);

        // Keep the current icon and cover (possibly from an earlier version) when the repo doesn't provide one.
        const [authorIcon, cover] = await Promise.all([
          getGithubIconUrl(match[0]).then((result) => result.data, () => null),
          getQmodCoverUrl(match[0]).then((result) => result.data, () => null)
        ]);

        if (authorIcon) {
          setFieldValue(authorIconElement, authorIcon);
        }

        if (cover) {
          setFieldValue(modCoverElement, cover);
        }

        updateImagePreviews();
      }
    }

    // Look up earlier versions when the mod ID is typed in by hand.
    modIdElement.addEventListener("change", () => {
      fillFromKnownMod();
    });

    // A field the user changes is no longer marked as filled from an earlier version.
    for (const element of [
      modDescriptionElement,
      modCreatorsElement,
      modAiElement,
      modSourceLinkElement,
      modWebsiteLinkElement,
      modFundingLinkElement,
      authorIconElement,
      modCoverElement
    ] as FillableElement[]) {
      for (const eventName of ["input", "change"]) {
        element.addEventListener(eventName, () => {
          if (prefilledValues.has(element) && prefilledValues.get(element) != element.value) {
            prefilledValues.delete(element);
            delete element.dataset.prefilled;
          }
        });
      }
    }

    // Prevent default behavior for dragover event
    qmodDropZoneElement.addEventListener("dragover", (e) => e.preventDefault(), false);

    // Event listener for dropping files into the qmodDropZone
    qmodDropZoneElement.addEventListener("drop", qmodDropHandler);

    // Event listener for clicking the QMOD button
    loadQmodElement.addEventListener("click", loadQmod);

    // Event listener for onchange event of link input
    modDownloadLinkElement.addEventListener("change", modDownloadLinkChangeHandler);

    // Add url drop handlers to the following
    for (const element of [modDownloadLinkElement, modSourceLinkElement, modWebsiteLinkElement, modFundingLinkElement, modCoverElement]) {
      element.addEventListener("drop", urlDropHandler);
    }

    // Event listener for generate button click event
    generateButtonElement.addEventListener("click", generateJson);
  })().catch((error) => {
    console.error(error);

    alert("An error has occurred during initialization, please see the console for more information.");
  });
</script>
