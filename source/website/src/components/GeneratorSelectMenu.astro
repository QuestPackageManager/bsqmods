---
export interface Props {
  id: string;
  values: [string, string, boolean][];
}

const { id, values } = Astro.props as Props;
---

<div
  class={`
    block
    min-w-0
    text-left
  `}
>
  <label
    for={id}
    class={`
      block
      font-bold
      pb-1
      text-xs
      leading-snug
      text-shadow-[0_0_4px_rgba(0,0,0,1)]
      text-white
    `}
  >
    <slot />
  </label>
  <select
    class={`
      backdrop-blur
      bg-input-bg
      border
      border-white-alpha-20
      h-10
      min-w-0
      px-2.5
      py-1.5
      text-sm
      leading-normal
      placeholder-input-placeholder
      rounded-md
      text-input-text
      w-full
    `}
    id={id}
    aria-describedby={Astro.slots.has("description") ? `${id}Description` : undefined}
  >
    {
      values?.map((value) => (
        <option
          value={value[0]}
          selected={value[2] ? "selected" : null}
        >
          {value[1]}
        </option>
      ))
    }
  </select>
  <slot name="description" />
</div>
