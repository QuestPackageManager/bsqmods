---
import { ChevronUpDownIcon } from "@heroicons/react/20/solid";

export interface Props {
  id: string;
  values: [string, string, boolean][];
  required?: boolean;
}

const { id, values, required = false } = Astro.props as Props;
---

<div class="block min-w-0 text-left">
  <label
    for={id}
    class="generator-label"
  >
    <slot />
    {required && <span class="text-error" aria-hidden="true">*</span>}
  </label>
  <div class="relative">
    <select
      class="generator-field h-10 cursor-pointer appearance-none pr-9 [&>option]:bg-base-200 [&>option]:text-base-content"
      id={id}
      aria-required={required ? "true" : undefined}
      aria-describedby={Astro.slots.has("description") ? `${id}Description` : undefined}
    >
      {
        values?.map((value) => (
          <option
            value={value[0]}
            selected={value[2] ? "selected" : null}
          >
            {value[1]}
          </option>
        ))
      }
    </select>
    <ChevronUpDownIcon
      className="pointer-events-none absolute top-1/2 right-2.5 size-5 -translate-y-1/2 text-input-text/60"
      aria-hidden="true"
    />
  </div>
  <slot name="description" />
</div>
