---
export interface Props {
  id: string;
  placeholder: string;
  rows?: number;
}

const { id, placeholder, rows } = Astro.props as Props;
---

<div
  class={`
    block
    min-w-0
    text-left
  `}
>
  <label
    for={id}
    class={`
      block
      font-bold
      pb-1
      text-xs
      leading-snug
      text-shadow-[0_0_4px_rgba(0,0,0,1)]
      text-white
    `}
  >
    <slot />
  </label>
  <textarea
    class={`
      backdrop-blur
      bg-input-bg
      border
      border-white-alpha-20
      min-w-0
      px-2.5
      py-1.5
      text-sm
      leading-normal
      placeholder-input-placeholder
      rounded-md
      text-input-text
      w-full
    `}
    id={id}
    placeholder={placeholder}
    rows={rows}
  ></textarea>
</div>
