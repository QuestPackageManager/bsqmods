---
export interface Props {
  id: string;
  placeholder: string;
  rows?: number;
  required?: boolean;
}

const { id, placeholder, rows, required = false } = Astro.props as Props;
---

<div class="block min-w-0 text-left">
  <label
    for={id}
    class="generator-label"
  >
    <slot />
    {required && <span class="text-error" aria-hidden="true">*</span>}
  </label>
  <textarea
    class="generator-field resize-y py-2"
    id={id}
    placeholder={placeholder}
    rows={rows}
    aria-required={required ? "true" : undefined}
  ></textarea>
</div>
