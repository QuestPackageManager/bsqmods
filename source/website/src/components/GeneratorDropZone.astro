---
export interface Props {
  id: string;
}

const { id } = Astro.props as Props;
---

<div
  class={`
    backdrop-blur
    bg-dropzone-bg
    border-2
    border-dropzone-border
    border-dashed
    cursor-pointer
    flex
    font-semibold
    items-center
    justify-center
    p-2.5
    text-sm
    rounded-lg
    text-dropzone-text
    text-center
    w-full
  `}
  id={id}
>
  <slot />
</div>
