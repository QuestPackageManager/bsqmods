---
export interface Props {
  id: string;
  placeholder: string;
  value?: string;
  required?: boolean;
  type?: "text" | "url";
}

const { id, placeholder, value, required = false, type = "text" } = Astro.props as Props;
const hasHint = Astro.slots.has("hint");
---

<div class="block min-w-0 text-left">
  <label
    for={id}
    class="generator-label"
  >
    <slot />
    {required && <span class="text-error" aria-hidden="true">*</span>}
  </label>
  <input
    class="generator-field h-10"
    id={id}
    placeholder={placeholder}
    value={value}
    type={type}
    autocomplete="off"
    spellcheck="false"
    aria-required={required ? "true" : undefined}
    aria-describedby={hasHint ? `${id}Hint` : undefined}
  />
  {
    hasHint && (
      <p id={`${id}Hint`} class="generator-hint">
        <slot name="hint" />
      </p>
    )
  }
</div>
